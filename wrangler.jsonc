{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hunuku",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "hunuku.co.nz",
      "custom_domain": true
    },
    {
      "pattern": "www.hunuku.co.nz",
      "custom_domain": true
    }
  ]
}
