{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hunukuweb",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "hunuku@outlook.co.nz"
    }
  ]
}
